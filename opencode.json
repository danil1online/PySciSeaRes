{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai-compatible/qwen-local",
  "provider": {
    "openai-compatible": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local Llama.cpp",
      "options": {
        "baseURL": "http://192.168.0.104:8181/v1",
        "apiKey": "any-string-here"
      },
      "models": {
        "qwen-local": {
          "id": "Qwen3.6-35B-A3B-UD-Q4_K_M.gguf",
          "attachment": true,
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 196608,
            "output": 16384
          },
          "capabilities": {
            "vision": false
          }
        }
      }
    }
  },
  "tools": {
    "websearch": true,
    "webfetch": true,
    "codesearch": true
  },
  "permission": {
    "websearch": "allow",
    "webfetch": "allow",
    "codesearch": "allow",
    "read": "allow",
    "edit": "allow",
    "bash": "allow",
    "external_directory": "allow"
  }
}
